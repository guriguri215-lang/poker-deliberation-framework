# Optional. Local calculators, doctor, schema validation, and tests do not need it.
OPENAI_API_KEY=
# Optional run-artifact directory. Environment configuration must stay inside the workspace.
POKER_DELIBERATION_RUNS_DIR=runs
# Disable sensitive model/tool payload capture when Agents SDK tracing is enabled.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
